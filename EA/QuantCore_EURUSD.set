; QuantCore AI EA v1.31 — EURUSD H1
; LIVE REPORT FINDING: PF 0.30 (-$5,030 net), $963 commissions on 26 trades
; ROOT CAUSE: threshold 0.58 was too loose → overtrading with poor selectivity
; FIX: threshold raised to 0.76, risk halved to 0.40%, max 1 position
; Sessions: London + Overlap + NY (Asia OFF — EURUSD Asia = wide spread, no edge)

; ════ PROP FIRM RISK ════
Inp_MaxDailyLoss=4.5
Inp_MaxTotalLoss=9.0
Inp_RiskPerTrade=0.40
Inp_ProfitLockAt=6.0
Inp_ProfitLockDD=1.0

; ════ AI SIGNAL ENGINE ════
Inp_MinScore=0.76
Inp_MinScoreMTF=0.60
Inp_MinADX=20.0
Inp_EMA_Fast=20
Inp_EMA_Mid=50
Inp_EMA_Slow=200
Inp_RSI_Period=14
Inp_Stoch_K=5
Inp_Stoch_D=3
Inp_ADX_Period=14
Inp_ATR_Period=14

; ════ TRADE MANAGEMENT ════
Inp_SL_ATR_Mult=1.5
Inp_TP_ATR_Mult=3.0
Inp_TrailingStop=true
Inp_Trail_ATR=1.2
Inp_MaxPositions=1
Inp_LongExtraScore=0.05
Inp_SkipSessionEdge=true
Inp_MinSL_Pips=15.0

; ════ CONSECUTIVE LOSS GUARD ════
Inp_MaxConsecLoss=3
Inp_ConsecPauseHours=4.0

; ════ KALMAN FILTER ════
Inp_KF_Delta=0.0001
Inp_KF_Ve=0.001

; ════ TRADING SESSIONS (UTC) ════
Inp_TradeAsia=false
Inp_TradeLondon=true
Inp_TradeNewYork=true
Inp_BoostOverlap=true
Inp_OverlapBoost=0.03
Inp_CloseFriday=true

; ════ SIGNAL WEIGHTS ════
W_Trend=0.30
W_Momentum=0.25
W_Regime=0.20
W_Kalman=0.15
W_MTF=0.10
